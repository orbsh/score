# 类型定义用大括号：enum 的变体名就是出口端口，struct 的名字就是构造器
enum Shape {
  Circle { r: Int }
  Rect { w: Int, h: Int }
}

struct Person {
  name: Text
  age: Int
}

@doc("端口上可以直接写声明的类型")
def describe(s: Shape) -> (out: Text) {
  out = lit(value: "a shape")
}

c = Circle(r: 3)
p = Person(name: "ada", age: 36)
d = describe(s: c)
c -> print
p -> print
d -> print